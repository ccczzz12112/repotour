# 复制本文件为 .env（.env 已被 gitignore，绝不提交密钥！）
# mock = 无需 API Key，离线跑通全流程（开发/联调）；live = 真实 LLM
LLM_MODE=mock
# 任意 OpenAI 兼容接口均可（阿里云百炼/DeepSeek/月之暗面等）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL_MAP=qwen-flash
LLM_MODEL_STRONG=qwen-plus
TOP_K_FILES=150
MAX_FILES=2000
MAX_REPO_MB=50
MAP_WORKERS=4
ALLOW_LOCAL_REPOS=1
